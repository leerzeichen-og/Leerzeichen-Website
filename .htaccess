# leerzeichen.at — Serverregeln. Bewusst kurz gehalten; jede Zeile erklärt.

# Keine Verzeichnislisten anzeigen.
Options -Indexes

# UTF-8 als Vorgabe für Textdateien.
AddDefaultCharset utf-8

# Fehlerseite.
ErrorDocument 404 /404.php

# Die Staging-Domain darf NICHT in Suchmaschinen: verbindlicher Header,
# nur solange die Seite unter neu.leerzeichen.at läuft. Beim Livegang auf
# der Hauptdomain greift die Regel nicht mehr — nichts zu ändern.
SetEnvIfNoCase Host ^neu\. LZ_STAGING
Header set X-Robots-Tag "noindex, nofollow, noarchive" env=LZ_STAGING

# --- Sicherheits-Header (Durchsicht 13.10.2026) ------------------------------
# Browser dürfen Dateitypen nicht raten (nehmen den Content-Type wörtlich).
Header set X-Content-Type-Options "nosniff"
# Die Seite darf nirgends als Frame eingebettet werden (Clickjacking) —
# doppelt gesetzt: dieser Header für ältere Browser, frame-ancestors unten.
Header set X-Frame-Options "DENY"
# Beim Klick auf externe Links geht nur die Domain als Herkunft mit.
Header set Referrer-Policy "strict-origin-when-cross-origin"
# Browser-Funktionen, die diese Website nie braucht, ausdrücklich aus.
Header set Permissions-Policy "camera=(), microphone=(), geolocation=()"
# HTTPS verbindlich merken (180 Tage; bewusst ohne Subdomains — space. und
# analytics. verwalten sich selbst).
Header set Strict-Transport-Security "max-age=15552000"
# Content-Security-Policy: Laden nur von der eigenen Domain plus dem
# eigenen Matomo — eingeschleuste Fremd-Skripte/-Bilder blockt der Browser.
# 'unsafe-inline' bleibt nötig (JSON-LD, Seiten-Skripte, style-Attribute);
# form-action erlaubt mailto: für das Newsletter-Formular.
Header set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' https://analytics.leerzeichen.at; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://analytics.leerzeichen.at; font-src 'self'; connect-src 'self' https://analytics.leerzeichen.at; media-src 'self'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'self' mailto:"

# Punktdateien nie ausliefern (eine versehentlich hochgeladene .env o. Ä.
# wäre sonst lesbar); .well-known bleibt frei (Zertifikats-Prüfungen).
RedirectMatch 404 /\.(?!well-known)

RewriteEngine On

# Eine kanonische Adresse: leerzeichen.at (ohne www) leitet dauerhaft auf
# https://www.leerzeichen.at um — beide bleiben erreichbar, aber Links und
# Suchmaschinen laufen auf EINER Form zusammen. Greift nur auf der nackten
# Hauptdomain; Staging (neu.) bleibt unberührt. Liegt schon jetzt bereit,
# damit beim Livegang nichts zu ändern ist.
RewriteCond %{HTTP_HOST} ^leerzeichen\.at$ [NC]
RewriteRule ^(.*)$ https://www.leerzeichen.at/$1 [R=301,L]

# sitemap.xml wird von sitemap.php erzeugt (liest Seitenliste + Projekte).
RewriteRule ^sitemap\.xml$ sitemap.php [L]

# Projektseiten: /referenzen/<slug>/ → Template mit dem Slug als Parameter.
# (Das Template kommt mit dem Referenzen-Schritt; die Regel greift erst dann,
# weil sie nur zieht, wenn die Zieldatei existiert.)
RewriteCond %{DOCUMENT_ROOT}/referenzen/projekt.php -f
RewriteRule ^referenzen/([a-z0-9-]+)/?$ referenzen/projekt.php?slug=$1 [L,QSA]

# daten/ gehört Space (JSON-Rohdaten) — nicht direkt ausliefern.
# Die Templates lesen die Dateien serverseitig, dafür braucht es keinen HTTP-Zugriff.
RewriteRule ^daten/ - [F,L]

# Alte WordPress-Adressen: KEINE Umleitungen nötig — leerzeichen.at war
# jahrelang nur eine Coming-Soon-Seite, es gibt keine verlinkten Alt-URLs
# (Roman, 12.10.2026). Sollte doch eine auftauchen, Muster:
#   Redirect 301 /alte-seite/ https://www.leerzeichen.at/neue-seite/
